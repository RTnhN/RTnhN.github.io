---
layout: null
permalink: /feed/notes.xml
---
<?xml version="1.0" encoding="utf-8"?>
{%- assign base = site.url | append: site.baseurl -%}
{%- assign last_char = base | slice: -1 -%}
{%- if last_char == "/" -%}{%- assign base_len = base | size | minus: 1 -%}{%- assign base = base | slice: 0, base_len -%}{%- endif -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name | xml_escape }} – Notes</title>
  <link href="{{ base }}/feed/notes.xml" rel="self" type="application/atom+xml" />
  <link href="{{ base }}/notes/" rel="alternate" type="text/html" />
  <id>{{ base }}/notes/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {% assign notes = site.notes | sort: "date" | reverse %}
  {% for note in notes limit: 50 %}
  {% capture note_text %}{{ note.content | strip_html | normalize_whitespace }}{% endcapture %}
  <entry>
    <title>{% if note_text != "" %}{{ note_text | truncatewords: 10 | xml_escape }}{% else %}Photo{% endif %}</title>
    <link href="{{ base }}{{ note.url }}" rel="alternate" type="text/html" />
    <id>{{ base }}{{ note.url }}</id>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.date | date_to_xmlschema }}</updated>
    {% for tag in note.tags %}<category term="{{ tag | xml_escape }}" />{% endfor %}
    <content type="html">{% capture html %}{{ note.content }}{% for img in note.images %}<p><img src="{{ base }}{{ img.src }}" alt="{{ img.alt | escape }}" /></p>{% endfor %}{% endcapture %}{{ html | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
